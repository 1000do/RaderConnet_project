@{
    ViewData["Title"] = "Radar";
    var rawUserName = Context.Request.Cookies["UserName"];
    var userName = string.IsNullOrEmpty(rawUserName) ? "Khách" : Uri.UnescapeDataString(rawUserName);
    var userAvatar = Context.Request.Cookies["UserAvatar"];
    var defaultAvatarUrl = string.IsNullOrEmpty(userAvatar) ? $"https://ui-avatars.com/api/?name={userName}&background=006a62&color=fff" : userAvatar;
}

<main class="w-full pt-14 flex justify-center">
<div class="w-full max-w-[1440px] px-2 sm:px-4 py-4 flex items-start justify-between gap-6">
<!-- ========================================================= -->
<!-- 1. LEFT SIDEBAR: 320px Sticky                            -->
<!-- ========================================================= -->
<aside class="hidden xl:flex flex-col gap-3.5 w-[320px] shrink-0 sticky top-[70px] max-h-[calc(100vh-80px)] overflow-y-auto custom-scrollbar pr-1.5">
<!-- User Profile Radar Card -->
<div class="bg-fb-card rounded-xl p-3.5 border border-fb-border shadow-sm flex items-center gap-3">
<div class="relative shrink-0">
<img alt="User @userName" class="w-12 h-12 rounded-full object-cover ring-2 ring-fb-blue/20" src="@defaultAvatarUrl" onerror="this.src='/images/man.png';"/>
<span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-fb-green border-2 border-white rounded-full"></span>
</div>
<div class="min-w-0 flex-1">
<h2 class="font-bold text-[15px] text-fb-text truncate">@userName</h2>
<div class="flex items-center gap-1.5 mt-0.5">
<span class="w-2 h-2 rounded-full bg-fb-green animate-pulse"></span>
<span class="text-[12px] font-semibold text-fb-green truncate">Đang bật Radar kết nối 🟢</span>
</div>
</div>
<button class="p-1.5 text-fb-subtext hover:text-fb-text hover:bg-fb-hover rounded-full transition" title="Cài đặt hồ sơ">
<span class="material-symbols-outlined text-[19px]">tune</span>
</button>
</div>
<!-- Distance Radius Slider Widget -->
<div class="bg-fb-card rounded-xl p-4 border border-fb-border shadow-sm flex flex-col gap-3">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-fb-blue text-[20px]">radar</span>
<span class="font-semibold text-[14px] text-fb-text">Bán kính quét Radar</span>
</div>
<span class="px-2 py-0.5 bg-fb-blue-subtle text-fb-blue font-bold text-[12px] rounded-full" id="radius-badge">2.0 km</span>
</div>
<div class="flex flex-col gap-1">
<input class="w-full h-1.5 bg-[#E4E6EB] rounded-lg appearance-none cursor-pointer accent-fb-blue" id="radius-slider" max="5000" min="500" oninput="document.getElementById('radius-badge').innerText = (this.value >= 1000 ? (this.value/1000).toFixed(1) + ' km' : this.value + ' m')" step="250" type="range" value="2000"/>
<div class="flex justify-between text-[11px] font-medium text-fb-subtext mt-1">
<span>500m</span>
<span>1km</span>
<span class="text-fb-blue font-bold">2km</span>
<span>3.5km</span>
<span>5km</span>
</div>
</div>
<div class="border-t border-fb-border pt-3 flex flex-col gap-2.5">
<label class="flex items-center justify-between cursor-pointer group">
<div class="flex items-center gap-2">
<span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center material-symbols-outlined text-[16px]">bolt</span>
<span class="text-[13px] font-medium text-fb-text group-hover:text-fb-blue transition">Đang diễn ra ngay</span>
</div>
<input checked="" class="w-4 h-4 rounded text-fb-blue focus:ring-fb-blue rounded accent-fb-blue" type="checkbox"/>
</label>
<label class="flex items-center justify-between cursor-pointer group">
<div class="flex items-center gap-2">
<span class="w-7 h-7 rounded-lg bg-red-50 text-red-600 flex items-center justify-center material-symbols-outlined text-[16px]">group_add</span>
<span class="text-[13px] font-medium text-fb-text group-hover:text-fb-blue transition">Cần người gấp (thiếu 1-2)</span>
</div>
<input checked="" class="w-4 h-4 rounded text-fb-blue focus:ring-fb-blue rounded accent-fb-blue" type="checkbox"/>
</label>
</div>
</div>
<!-- Quick Filter Pills -->
<div class="bg-fb-card rounded-xl p-4 border border-fb-border shadow-sm flex flex-col gap-2.5">
<div class="flex items-center justify-between">
<span class="text-[13px] font-bold text-fb-subtext uppercase tracking-wider">Lọc theo sở thích</span>
<span class="text-[12px] text-fb-blue hover:underline cursor-pointer">Làm mới</span>
</div>
<div class="flex flex-wrap gap-1.5 pt-1">
<button class="px-3 py-1.5 rounded-full bg-fb-blue text-white text-[13px] font-semibold transition shadow-xs">
              Tất cả
            </button>
<button class="px-3 py-1.5 rounded-full bg-fb-bg hover:bg-fb-blue-subtle hover:text-fb-blue text-fb-text text-[13px] font-medium transition flex items-center gap-1">
<span>☕</span> Cà phê &amp; Tech
            </button>
<button class="px-3 py-1.5 rounded-full bg-fb-bg hover:bg-fb-blue-subtle hover:text-fb-blue text-fb-text text-[13px] font-medium transition flex items-center gap-1">
<span>🎲</span> Board Game
            </button>
<button class="px-3 py-1.5 rounded-full bg-fb-bg hover:bg-fb-blue-subtle hover:text-fb-blue text-fb-text text-[13px] font-medium transition flex items-center gap-1">
<span>🏸</span> Thể thao &amp; Cầu lông
            </button>
<button class="px-3 py-1.5 rounded-full bg-fb-bg hover:bg-fb-blue-subtle hover:text-fb-blue text-fb-text text-[13px] font-medium transition flex items-center gap-1">
<span>🎸</span> Âm nhạc
            </button>
<button class="px-3 py-1.5 rounded-full bg-fb-bg hover:bg-fb-blue-subtle hover:text-fb-blue text-fb-text text-[13px] font-medium transition flex items-center gap-1">
<span>🎨</span> Workshop &amp; Vẽ
            </button>
</div>
</div>
<!-- Hot Areas List -->
<div class="bg-fb-card rounded-xl p-4 border border-fb-border shadow-sm flex flex-col gap-2">
<span class="text-[13px] font-bold text-fb-subtext uppercase tracking-wider">Khu vực sôi động gần bạn</span>
<div class="flex flex-col gap-1 mt-1">
<a class="flex items-center justify-between p-2 rounded-lg hover:bg-fb-bg transition" href="#">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-fb-blue text-[18px]">location_on</span>
<span class="text-[13px] font-medium text-fb-text">Quận Hoàn Kiếm (Phố Cổ)</span>
</div>
<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-fb-green-light text-fb-green">14 kèo</span>
</a>
<a class="flex items-center justify-between p-2 rounded-lg hover:bg-fb-bg transition" href="#">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-fb-blue text-[18px]">location_on</span>
<span class="text-[13px] font-medium text-fb-text">Quận Cầu Giấy (Duy Tân)</span>
</div>
<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-fb-green-light text-fb-green">19 kèo</span>
</a>
<a class="flex items-center justify-between p-2 rounded-lg hover:bg-fb-bg transition" href="#">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-fb-blue text-[18px]">location_on</span>
<span class="text-[13px] font-medium text-fb-text">Quận Hai Bà Trưng</span>
</div>
<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-fb-bg text-fb-subtext">9 kèo</span>
</a>
</div>
</div>
</aside>
<!-- ========================================================= -->
<!-- 2. MIDDLE FEED: 680px - 720px max-width                  -->
<!-- ========================================================= -->
<div class="flex-1 max-w-[700px] flex flex-col gap-4 min-w-0">
<!-- 2.1 FACEBOOK STYLE COMPOSER: 'TẠO KÈO NHANH TRONG 30 GIÂY' -->
<div class="bg-fb-card rounded-xl p-3.5 border border-fb-border shadow-sm flex flex-col gap-3">
<div class="flex items-center gap-2.5">
<img alt="@userName avatar" class="w-10 h-10 rounded-full object-cover ring-1 ring-fb-border shrink-0" src="@defaultAvatarUrl" onerror="this.src='/images/man.png';"/>
<button class="flex-1 text-left bg-fb-bg hover:bg-[#E4E6EB] px-4 py-2.5 rounded-full text-fb-subtext text-[14px] transition cursor-pointer flex items-center justify-between" type="button">
<span>Bạn đang muốn tụ tập sở thích gì ngay lúc này?</span>
<span class="material-symbols-outlined text-fb-blue text-[20px]">bolt</span>
</button>
</div>
<div class="border-t border-fb-border pt-2 grid grid-cols-3 gap-1">
<button class="flex items-center justify-center gap-2 py-2 px-1 rounded-lg hover:bg-fb-hover transition text-fb-subtext font-medium text-[13px]" type="button">
<span class="material-symbols-outlined text-[#FA383E] text-[20px]">location_on</span>
<span class="truncate">Điểm hẹn gần bạn</span>
</button>
<button class="flex items-center justify-center gap-2 py-2 px-1 rounded-lg hover:bg-fb-hover transition text-fb-subtext font-medium text-[13px]" type="button">
<span class="material-symbols-outlined text-[#F7B125] text-[20px]">timer</span>
<span class="truncate">Trong 15-30p</span>
</button>
<button class="flex items-center justify-center gap-2 py-2 px-1 rounded-lg hover:bg-fb-hover transition text-fb-subtext font-medium text-[13px]" type="button">
<span class="material-symbols-outlined text-fb-blue text-[20px]">group_add</span>
<span class="truncate">Cần 2-4 bạn</span>
</button>
</div>
</div>
<!-- 2.2 RADAR MAP CANVAS WIDGET -->
<div class="bg-fb-card rounded-xl border border-fb-border shadow-sm overflow-hidden flex flex-col">
<!-- Widget Header -->
<div class="px-4 py-3 border-b border-fb-border flex items-center justify-between">
<div class="flex items-center gap-2">
<div class="w-3 h-3 rounded-full bg-fb-green relative">
<span class="animate-ping absolute inset-0 rounded-full bg-fb-green opacity-75"></span>
</div>
<h3 class="font-bold text-[15px] text-fb-text">Bản Đồ Radar Thời Gian Thực</h3>
<span class="px-2 py-0.5 bg-fb-green-light text-fb-green font-bold text-[11px] rounded-full">12 kèo đang hoạt động</span>
</div>
<div class="flex items-center gap-1 text-fb-subtext">
<button class="p-1.5 hover:bg-fb-hover rounded-full transition" title="Làm mới sóng radar">
<span class="material-symbols-outlined text-[18px]">refresh</span>
</button>
<button class="p-1.5 hover:bg-fb-hover rounded-full transition" title="Toàn màn hình">
<span class="material-symbols-outlined text-[18px]">fullscreen</span>
</button>
</div>
</div>
<!-- Radar Visual Stage -->
<div class="relative w-full h-[320px] bg-[#0A1128] overflow-hidden select-none">
<!-- Simulated Map Roads and Grid Lines (Subtle) -->
<div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(#204080 1px, transparent 1px), linear-gradient(to right, #142144 1px, transparent 1px), linear-gradient(to bottom, #142144 1px, transparent 1px); background-size: 24px 24px, 48px 48px, 48px 48px;"></div>
<!-- Concentric Sonar Rings -->
<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
<div class="w-28 h-28 rounded-full border border-fb-blue/30 flex items-center justify-center">
<div class="w-56 h-56 rounded-full border border-fb-blue/25 flex items-center justify-center">
<div class="w-80 h-80 rounded-full border border-fb-blue/20 flex items-center justify-center">
<div class="w-[420px] h-[420px] rounded-full border border-fb-blue/15"></div>
</div>
</div>
</div>
<!-- Crosshair Lines -->
<div class="absolute w-full h-px bg-fb-blue/20"></div>
<div class="absolute h-full w-px bg-fb-blue/20"></div>
<!-- Radar Sweeping Beam -->
<div class="absolute w-[360px] h-[360px] rounded-full bg-[conic-gradient(from_0deg,transparent_0_300deg,rgba(24,119,242,0.28)_360deg)] radar-sweep pointer-events-none"></div>
</div>
<!-- Radar Radius Tag -->
<div class="absolute top-3 right-3 bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded-md text-[11px] font-semibold text-white/90 border border-white/10">
              Quét trong 2.0 km
            </div>
<!-- CENTER USER PIN -->
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex flex-col items-center">
<div class="relative">
<div class="w-10 h-10 rounded-full ring-4 ring-fb-blue/40 bg-fb-blue p-0.5 shadow-xl">
<img alt="Bạn" class="w-full h-full rounded-full object-cover" src="@defaultAvatarUrl" onerror="this.src='/images/man.png';"/>
</div>
<span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-fb-green border-2 border-white rounded-full"></span>
</div>
<span class="bg-white/95 text-fb-text text-[11px] font-bold px-2 py-0.5 rounded shadow mt-1">Vị trí của bạn</span>
</div>
<!-- INTERACTIVE PIN 1: Tech & Coffee (Top-Right) -->
<div class="absolute top-10 right-16 z-20 group cursor-pointer">
<div class="relative flex items-center justify-center">
<span class="animate-ping absolute w-8 h-8 rounded-full bg-fb-blue opacity-70"></span>
<div class="w-8 h-8 rounded-full bg-fb-blue text-white flex items-center justify-center shadow-lg ring-2 ring-white text-[14px]">
                  ☕
                </div>
</div>
<!-- Pin Tooltip Card -->
<div class="absolute right-0 bottom-full mb-2 w-56 bg-white rounded-lg p-2 shadow-xl border border-fb-border pointer-events-none">
<div class="flex items-center justify-between text-[11px]">
<span class="font-bold text-fb-blue">☕ Cà phê Code &amp; AI</span>
<span class="text-fb-green font-bold">Cách 350m</span>
</div>
<p class="text-[11px] text-fb-subtext truncate mt-0.5">Cộng Cà Phê Tràng Thi • Còn 2 chỗ</p>
</div>
</div>
<!-- INTERACTIVE PIN 2: Board Game (Bottom-Left) -->
<div class="absolute bottom-12 left-14 z-20 group cursor-pointer">
<div class="relative flex items-center justify-center">
<span class="animate-ping absolute w-8 h-8 rounded-full bg-purple-500 opacity-70"></span>
<div class="w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center shadow-lg ring-2 ring-white text-[14px]">
                  🎲
                </div>
</div>
<div class="absolute left-0 top-full mt-2 w-56 bg-white rounded-lg p-2 shadow-xl border border-fb-border pointer-events-none">
<div class="flex items-center justify-between text-[11px]">
<span class="font-bold text-purple-700">🎲 Kèo Board Game</span>
<span class="text-fb-green font-bold">Cách 600m</span>
</div>
<p class="text-[11px] text-fb-subtext truncate mt-0.5">The Meeple Hub • Cần 3 người</p>
</div>
</div>
<!-- INTERACTIVE PIN 3: Badminton (Top-Left) -->
<div class="absolute top-14 left-20 z-20 group cursor-pointer">
<div class="relative flex items-center justify-center">
<span class="animate-ping absolute w-8 h-8 rounded-full bg-fb-green opacity-70"></span>
<div class="w-8 h-8 rounded-full bg-fb-green text-white flex items-center justify-center shadow-lg ring-2 ring-white text-[14px]">
                  🏸
                </div>
</div>
<div class="absolute left-0 bottom-full mb-2 w-56 bg-white rounded-lg p-2 shadow-xl border border-fb-border pointer-events-none">
<div class="flex items-center justify-between text-[11px]">
<span class="font-bold text-fb-green">🏸 Cầu Lông Sân số 3</span>
<span class="text-fb-blue font-bold">Cách 1.2km</span>
</div>
<p class="text-[11px] text-fb-subtext truncate mt-0.5">Sân Hồ Đắc Di • Đang diễn ra</p>
</div>
</div>
</div>
</div>
<!-- ========================================================= -->
<!-- 2.3 MEETUP FEED CARD 1: CÀ PHÊ DEEP WORK & AI CODING       -->
<!-- ========================================================= -->
