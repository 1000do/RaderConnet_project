@{
    ViewData["Title"] = "Edit Profile";
}

<div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
    <div class="flex flex-col lg:flex-row gap-8">

        <aside class="w-full lg:w-72 flex-shrink-0">
            <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100 sticky top-24">
                <nav class="flex flex-col gap-2">
                    <a href="/User/Profile" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50 transition-all">
                        <span class="material-symbols-outlined">person</span>
                        <span>Profile</span>
                    </a>
                    <a href="/User/EditProfile" class="flex items-center gap-4 px-4 py-3 rounded-2xl bg-primary-container/30 text-primary font-bold transition-all">
                        <span class="material-symbols-outlined" style='font-variation-settings: "FILL" 1;'>edit_square</span>
                        <span>Edit Profile</span>
                    </a>
                    <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50 transition-all">
                        <span class="material-symbols-outlined">security</span>
                        <span>Security</span>
                    </a>
                    <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50 transition-all">
                        <span class="material-symbols-outlined">history</span>
                        <span>Purchase History</span>
                    </a>
                </nav>
            </div>
        </aside>

        <div class="flex-grow space-y-8">
            <div class="mb-4">
                <h1 class="text-3xl font-extrabold text-slate-800">Account Settings</h1>
                <p class="text-slate-500">Manage your digital profile and preferences.</p>
            </div>

            <section class="bg-white rounded-[2.5rem] p-8 md:p-10 shadow-sm border border-slate-100">
                <div class="flex items-center gap-6 mb-10 pb-8 border-b border-slate-50">
                    <div class="relative group">
                        <div class="w-24 h-24 rounded-[1.5rem] overflow-hidden ring-4 ring-primary/10">
                            <img src="https://ui-avatars.com/api/?name=Alex+Thorne&background=006a62&color=fff" class="w-full h-full object-cover" />
                        </div>
                        <button class="absolute -bottom-2 -right-2 bg-primary text-white p-2 rounded-xl shadow-lg hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined text-sm">photo_camera</span>
                        </button>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-slate-800">Alex Thorne</h3>
                        <p class="text-sm text-slate-500">Update your photo and personal details.</p>
                    </div>
                </div>

                <form class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">First Name</label>
                            <input type="text" value="Alex" class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">Last Name</label>
                            <input type="text" value="Thorne" class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">Email Address</label>
                        <input type="email" value="alex.thorne@atheneum.edu" class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">Bio</label>
                        <textarea rows="4" class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all resize-none">Passionate lifelong learner and aspiring UX architect. Exploring the intersection of design systems and psychology.</textarea>
                    </div>

                    <div class="pt-6 flex flex-wrap gap-4">
                        <button type="submit" class="px-10 py-4 bg-primary text-white font-bold rounded-2xl shadow-lg shadow-primary/20 hover:opacity-90 active:scale-95 transition-all">
                            Save Changes
                        </button>
                        <button type="button" class="px-10 py-4 bg-slate-100 text-slate-600 font-bold rounded-2xl hover:bg-slate-200 active:scale-95 transition-all">
                            Cancel
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>