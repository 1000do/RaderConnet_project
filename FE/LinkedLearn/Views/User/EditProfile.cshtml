@model LinkedLearn.Models.UserVM.UpdateProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
    <div class="flex flex-col lg:flex-row gap-8">

        <aside class="w-full lg:w-72 flex-shrink-0">
            <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100 sticky top-24">
                <nav class="flex flex-col gap-2">
                    <a href="/User/Profile" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50 transition-all">
                        <span class="material-symbols-outlined">person</span>
                        <span>Profile</span>
                    </a>
                    <a href="/User/EditProfile" class="flex items-center gap-4 px-4 py-3 rounded-2xl bg-primary-container/30 text-primary font-bold transition-all">
                        <span class="material-symbols-outlined" style='font-variation-settings: "FILL" 1;'>edit_square</span>
                        <span>Edit Profile</span>
                    </a>
                    <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50 transition-all">
                        <span class="material-symbols-outlined">security</span>
                        <span>Security</span>
                    </a>
                    <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50 transition-all">
                        <span class="material-symbols-outlined">history</span>
                        <span>Purchase History</span>
                    </a>
                </nav>
            </div>
        </aside>

        <div class="flex-grow space-y-8">
            <div class="mb-4">
                <h1 class="text-3xl font-extrabold text-slate-800">Account Settings</h1>
                <p class="text-slate-500">Manage your digital profile and preferences.</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-2xl mb-6 text-sm">
                    @ViewBag.ErrorMessage
                </div>
            }

            <section class="bg-white rounded-[2.5rem] p-8 md:p-10 shadow-sm border border-slate-100">
                <div class="flex items-center gap-6 mb-10 pb-8 border-b border-slate-50">
                    <div class="relative group">
                        <div class="w-24 h-24 rounded-[1.5rem] overflow-hidden ring-4 ring-primary/10">
                            <img src="@(string.IsNullOrEmpty(Model?.AvatarUrl) ? $"https://ui-avatars.com/api/?name={Model?.FullName ?? "User"}&background=006a62&color=fff" : Model.AvatarUrl)"
                                 class="w-full h-full object-cover" />
                        </div>
                        <button type="button" class="absolute -bottom-2 -right-2 bg-primary text-white p-2 rounded-xl shadow-lg hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined text-sm">photo_camera</span>
                        </button>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-slate-800">@(Model?.FullName ?? "New User")</h3>
                        <p class="text-sm text-slate-500">Update your photo and personal details.</p>
                    </div>
                </div>

                <form asp-controller="User" asp-action="EditProfile" method="post" class="space-y-6">
                    @* Hidden fields để giữ các giá trị không đổi *@
                    <input type="hidden" asp-for="AvatarUrl" />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        @* Full Name Field *@
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">Full Name</label>
                            <input asp-for="FullName" type="text" placeholder="Your full name..."
                                   class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all" />
                            <span asp-validation-for="FullName" class="text-xs text-red-500"></span>
                        </div>

                        @* Phone Number Field (TRƯỜNG MỚI THÊM) *@
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">Phone Number</label>
                            <input asp-for="PhoneNumber" type="tel" placeholder="Your phone number..."
                                   class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all" />
                            <span asp-validation-for="PhoneNumber" class="text-xs text-red-500"></span>
                        </div>
                    </div>

                    @* Bio Field *@
                    <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-400 ml-1">Bio</label>
                        <textarea asp-for="Bio" rows="4" placeholder="Tell us something about yourself..."
                                  class="w-full bg-slate-50 border-none rounded-2xl px-5 py-4 focus:ring-2 focus:ring-primary/20 transition-all resize-none"></textarea>
                        <span asp-validation-for="Bio" class="text-xs text-red-500"></span>
                    </div>

                    @* Action Buttons *@
                    <div class="pt-6 flex flex-wrap gap-4">
                        <button type="submit" class="px-10 py-4 bg-primary text-white font-bold rounded-2xl shadow-lg shadow-primary/20 hover:opacity-90 active:scale-95 transition-all">
                            Save Changes
                        </button>
                        <a href="/User/Profile" class="px-10 py-4 bg-slate-100 text-slate-600 text-center font-bold rounded-2xl hover:bg-slate-200 active:scale-95 transition-all">
                            Cancel
                        </a>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}