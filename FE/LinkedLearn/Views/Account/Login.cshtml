@using LinkedLearn.Models.UserVM
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<main class="flex-grow flex items-center justify-center pt-24 pb-12 px-6 bg-login-gradient relative">
    <div class="max-w-md w-full bg-white p-10 rounded-2xl shadow-xl relative z-10">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-headline font-extrabold text-on-surface mb-2">Welcome Back</h2>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded relative mb-4 text-sm text-center">
                    @ViewBag.ErrorMessage
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-2 rounded relative mb-4 text-sm text-center">
                    @TempData["SuccessMessage"]
                </div>
            }
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-6">
            <div>
                <label class="block text-sm font-semibold mb-1.5">Username or Email</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400">person</span>
                    <input asp-for="Identifier" class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-primary/20"
                           placeholder="Username or email..." type="text" required />
                </div>
                <span asp-validation-for="Identifier" class="text-xs text-red-500"></span>
            </div>

            <div>
                <div class="flex justify-between mb-1.5">
                    <label class="block text-sm font-semibold">Password</label>
                    <a class="text-xs text-primary font-medium hover:underline" href="/Account/ForgotPassword">Forgot password?</a>
                </div>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400">lock</span>
                    <input asp-for="Password" class="w-full pl-10 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-primary/20" placeholder="123456" type="password" required />
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-500"></span>
            </div>

            <button class="w-full py-4 bg-[#43e8d8] hover:bg-[#31ddcd] text-[#006a62] font-headline font-extrabold rounded-lg shadow-lg transition-all active:scale-[0.98]" type="submit">
                Login to LinkedLearn
            </button>
        </form>
    </div>
</main>