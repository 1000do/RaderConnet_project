@using LinkedLearn.Models.UserVM
@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Radar";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Micro-Meetup Radar</title>

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        "brand-primary": "#6366F1", // Indigo 500
                        "brand-secondary": "#ec4899", // Pink 500
                        "brand-accent": "#14b8a6", // Teal 500
                    },
                    animation: {
                        'blob': 'blob 7s infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        }
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col relative overflow-hidden">

    <!-- Animated Background Blobs -->
    <div class="absolute top-0 -left-4 w-72 h-72 bg-indigo-300 rounded-full mix-blend-multiply filter blur-2xl opacity-70 animate-blob"></div>
    <div class="absolute top-0 -right-4 w-72 h-72 bg-pink-300 rounded-full mix-blend-multiply filter blur-2xl opacity-70 animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-8 left-20 w-72 h-72 bg-teal-300 rounded-full mix-blend-multiply filter blur-2xl opacity-70 animate-blob animation-delay-4000"></div>

    <main class="flex-1 flex items-center justify-center p-4 relative z-10">
        
        <div class="w-full max-w-5xl flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-20">
            
            <!-- Left Side: Brand -->
            <div class="lg:w-1/2 text-center lg:text-left flex flex-col items-center lg:items-start">
                <div class="inline-flex items-center justify-center p-3 bg-gradient-to-br from-brand-primary to-brand-secondary rounded-2xl mb-6 shadow-lg shadow-indigo-500/30">
                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path>
                    </svg>
                </div>
                <h1 class="text-5xl lg:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-brand-secondary tracking-tight mb-6">
                    Radar Connect
                </h1>
                <p class="text-xl lg:text-2xl text-slate-600 leading-relaxed font-medium">
                    Phá vỡ khoảng cách. <br/>
                    Kết nối bạn bè có cùng sở thích quanh đây chỉ trong <span class="text-brand-primary font-bold">tích tắc.</span>
                </p>
            </div>

            <!-- Right Side: Login Card (Glassmorphism) -->
            <div class="w-full sm:w-[440px] shrink-0">
                <div class="bg-white/70 backdrop-blur-xl rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-white/50 p-8">
                    
                    <div class="text-center mb-8">
                        <h2 class="text-2xl font-bold text-slate-800">Chào mừng trở lại!</h2>
                        <p class="text-slate-500 text-sm mt-1">Đăng nhập để xem các kèo mới nhất</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="bg-red-50/80 backdrop-blur-sm border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm text-center mb-6 font-medium flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @ViewBag.ErrorMessage
                        </div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="bg-teal-50/80 backdrop-blur-sm border border-teal-200 text-teal-700 px-4 py-3 rounded-xl text-sm text-center mb-6 font-medium flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
                        
                        <!-- Email Input -->
                        <div class="group relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-slate-400 group-focus-within:text-brand-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path></svg>
                            </div>
                            <input asp-for="Identifier" class="w-full pl-11 pr-4 py-3.5 bg-white/50 border border-slate-200 rounded-xl text-slate-800 outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all placeholder:text-slate-400 font-medium"
                                   placeholder="Email hoặc Tên đăng nhập" type="text" required autofocus />
                        </div>
                        <span asp-validation-for="Identifier" class="text-xs text-red-500 font-medium ml-1"></span>

                        <!-- Password Input -->
                        <div class="group relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-slate-400 group-focus-within:text-brand-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            </div>
                            <input asp-for="Password" class="w-full pl-11 pr-4 py-3.5 bg-white/50 border border-slate-200 rounded-xl text-slate-800 outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all placeholder:text-slate-400 font-medium" 
                                   placeholder="Mật khẩu" type="password" required />
                        </div>
                        <span asp-validation-for="Password" class="text-xs text-red-500 font-medium ml-1"></span>

                        <!-- Forgot Password -->
                        <div class="flex justify-end">
                            <a href="/Account/ForgotPassword" class="text-sm font-semibold text-brand-primary hover:text-indigo-600 transition-colors">
                                Quên mật khẩu?
                            </a>
                        </div>

                        <!-- Submit Button -->
                        <div class="pt-2">
                            <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold text-lg py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
                                Đăng Nhập
                            </button>
                        </div>
                    </form>

                    <div class="mt-8 pt-6 border-t border-slate-200/60 text-center">
                        <p class="text-slate-500 font-medium">Chưa có tài khoản?</p>
                        <a href="/Account/Register" class="inline-block mt-3 w-full bg-brand-primary/10 hover:bg-brand-primary/20 text-brand-primary font-bold text-lg py-3 rounded-xl transition-colors">
                            Tạo Tài Khoản Mới
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>
</html>