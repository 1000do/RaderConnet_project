@model LinkedLearn.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<main class="flex-grow flex items-center justify-center pt-24 pb-12 px-6 bg-login-gradient relative">
    <div class="w-full max-w-md bg-white p-10 rounded-2xl shadow-xl border border-slate-100 relative z-10">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-headline font-extrabold text-on-surface mb-2">Create Account</h2>
            <p class="text-slate-500 text-sm">Join LinkedLearn today and start learning.</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="mt-4 bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded text-sm text-center">
                    @ViewBag.ErrorMessage
                </div>
            }
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-on-surface mb-1.5">Full Name</label>
                <input asp-for="Username" class="w-full px-4 py-3 bg-slate-50 border-none rounded-lg focus:ring-2 focus:ring-primary/20 outline-none" placeholder="John Doe" type="text" required />
                <span asp-validation-for="Username" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-on-surface mb-1.5">Email address</label>
                <input asp-for="Email" class="w-full px-4 py-3 bg-slate-50 border-none rounded-lg focus:ring-2 focus:ring-primary/20 outline-none" placeholder="name@company.com" type="email" required />
                <span asp-validation-for="Email" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-on-surface mb-1.5">Password</label>
                <input asp-for="Password" class="w-full px-4 py-3 bg-slate-50 border-none rounded-lg focus:ring-2 focus:ring-primary/20 outline-none" placeholder="••••••••" type="password" required />
                <span asp-validation-for="Password" class="text-xs text-red-500"></span>
            </div>

            <button class="w-full py-4 bg-[#43e8d8] text-[#006a62] hover:bg-[#31ddcd] font-headline font-extrabold rounded-lg shadow-lg hover:opacity-90 transition-all mt-4" type="submit">
                Get Started
            </button>

            <p class="text-center text-sm text-slate-500 mt-6">
                Already have an account? <a class="text-primary font-bold hover:underline" href="/Account/Login">Login</a>
            </p>
        </form>
    </div>
</main>