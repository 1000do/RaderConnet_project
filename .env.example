# ==========================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env và điền cấu hình thực tế
# ==========================================

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DB=UserDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

JWT_SECRET_KEY=your_jwt_secret_key_must_be_at_least_32_chars_long!
JWT_ISSUER=LinkedLearnGateway
JWT_AUDIENCE=LinkedLearnClients

GATEWAY_PORT=5000
USER_API_PORT=8081
FRONTEND_PORT=3000
